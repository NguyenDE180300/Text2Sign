# ----- ĐƯỜNG DẪN TRÊN MÁY HOST (MÁY THẬT) CỦA BẠN -----

# 1. Thư mục chứa phần mềm Blender (bản Linux/Ubuntu)
# Hãy trỏ đến thư mục giải nén của Blender (nơi có file thực thi 'blender')
HOST_BLENDER_DIR=/opt/blender-4.2.8

# 2. Thư mục chứa Rokoko Addon đã cài trên máy host
# Thường nằm trong ~/.config/blender/4.2/scripts/addons/...
HOST_ROKOKO_DIR=/path/to/blender/addons/rokoko-studio-live-blender-1-4-3
HOST_ROKOKO_LIBS_DIR=/path/to/blender/addons/rokoko-libraries

# 3. Thư mục data đầu vào (nơi chứa thư mục con 'smplx' xuất từ SMPLer-X)
HOST_SMPLX_OUTPUT_DIR=/path/to/Text2Sign/output_smplerx
